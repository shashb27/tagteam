# TagTeam server configuration. Copy to `.env` and edit.
# `cp .env.example .env`
#
# Required vs optional:
#   [required]  must be set for the container to behave correctly
#   [optional]  has a working default; set only if you need to override

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

# [optional] Port the HTTP + WS server listens on inside the container.
# The compose file maps host 3000 -> container PORT. Change both together.
PORT=3000

# [optional in dev, REQUIRED behind a reverse proxy / public deploy]
# Canonical public origin used to build invite URLs and to decide whether
# the session cookie is sent Secure. Set to your public https URL when
# behind a proxy, e.g. https://tagteam.example.com. Leave unset for local
# http://localhost:3000 use.
# BASE_URL=https://tagteam.example.com

# [optional] Comma-separated list of extra allowed WS/HTTP origins (CORS).
# Defaults to localhost + derived from BASE_URL. Add origins for cross-host
# dev access or alternate hostnames.
# ALLOWED_ORIGINS=https://tagteam.example.com,https://staging.tagteam.example.com

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# [optional] Directory for the SQLite database file. Matches the compose
# volume mount. Almost never needs changing.
DATA_DIR=/data

# [optional] Directory for log output. (NOTE: as of M2 the logger writes to
# <cwd>/logs; this var is reserved for when the logger honors it. The volume
# is still mounted so logs written to /app/logs can be relocated later.)
LOG_DIR=/logs

# [optional] Override the SQLite file path inside DATA_DIR.
# TAGTEAM_DB_PATH=/data/tagteam.db

# [optional] Pino log level: trace|debug|info|warn|error|fatal
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Claude / opencode backend
# ---------------------------------------------------------------------------

# [optional] Force the zero-credential MOCK backend (canned responses) for
# demos and CI. Unset (or any value other than "1") to use the real opencode
# backend, which reads local opencode config / CLI credentials.
# MOCK_CLAUDE=1

# [optional] Port for an already-running external opencode server. 0 = spawn
# an in-process opencode server on a random free port. Leave 0 unless you run
# your own opencode server out-of-process.
# OPENCODE_PORT=0

# [optional] Base URL of an external opencode server. When set, TagTeam talks
# to that server instead of spawning one in-process. Leave unset for the
# default in-process server.
# OPENCODE_BASE_URL=http://opencode:4096

# [optional] Model + provider override (both must be set together; the SDK
# requires both fields when either is set). null = use opencode default.
# OPENCODE_MODEL=glm-5.2
# OPENCODE_PROVIDER=bigmodel

# [optional] Working directory the opencode agent operates in. Defaults to
# the server's cwd. Set to a mounted workspace path for real runs.
# OPENCODE_CWD=/data/workspace

# ---------------------------------------------------------------------------
# NOTE on auth knobs
# ---------------------------------------------------------------------------
# The following are currently HARDCODED in server/ (not env-readable), so they
# are intentionally NOT listed here as live vars:
#   - BCRYPT_ROUNDS          (server/auth/local.js, fixed at 12)
#   - SESSION_COOKIE_MAX_AGE (server/auth/local.js, fixed at 604800s = 7d)
# If you need to make these env-configurable, that's a server change (out of
# scope for the M2 deploy task) — file a follow-up.
